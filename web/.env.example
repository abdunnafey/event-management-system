# Copy this file to ".env" (same folder) and put your own MySQL password.
# The .env file is read by db.py; never share it or upload it to GitHub.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_root_password
DB_NAME=event_management_db

# Any long random text; used by Flask to sign the flash messages cookie
FLASK_SECRET_KEY=change-this-to-any-long-random-text
